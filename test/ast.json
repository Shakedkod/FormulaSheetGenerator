                }
            }
        ],
        "attrs": {
            "callout_type": "example",
            "numbered": false,
            "title": ""
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "יהיו "
                    },
                    {
                        "type": "inline_math",
                        "raw": "f,g:\\mathbb{R}\\to \\mathbb{R}"
                    },
                    {
                        "type": "text",
                        "raw": " בעלות פונקציות קדומות. אזי:"
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "\\begin{align}\n1.\\; & \\int (f(x)+g(x))dx=\\int f(x)dx+\\int g(x)dx \\\\\n2.\\; & \\forall \\alpha \\in \\mathbb{R}:\\; \\int \\alpha f(x)dx=\\alpha\\int f(x)dx\n\\end{align}"
            }
        ],
        "attrs": {
            "callout_type": "theorem",
            "numbered": false,
            "title": "ליניאריות"
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "proof",
        "children": [
            {
                "type": "blank_line"
            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "נתון כי ל-"
                    },
                    {
                        "type": "inline_math",
                        "raw": "f,g"
                    },
                    {
                        "type": "text",
                        "raw": " פונקציות קדומות. נסמנם "
                    },
                    {
                        "type": "inline_math",
                        "raw": "F,G"
                    },
                    {
                        "type": "text",
                        "raw": " בהתאמה."
                    },
                    {
                        "type": "linebreak"
                    },
                    {
                        "type": "text",
                        "raw": "נסמן "
                    },
                    {
                        "type": "inline_math",
                        "raw": "H(x)=F(x)+G(x)"
                    },
                    {
                        "type": "text",
                        "raw": " ואז:"
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "H'(x) \\underset{\\begin{matrix}\n\\downarrow \\\\\n\\R{\\text{כללי גזירה}}\n\\end{matrix}}{=}F'(x)+G'(x)=f(x)+g(x)"
            },
            {
                "type": "block_math",
                "raw": "\\int f(x)dx+\\int g(x)dx \\underset{\\begin{matrix}\n\\downarrow \\\\\n\\R{\\text{הגדרת אינטגרל}}\n\\end{matrix}}{=} F(x)+G(x)=H(x) \\underset{\\begin{matrix}\n\\downarrow \\\\\n\\R{\\text{הגדרת אינטגרל}}\n\\end{matrix}}{=}\\int H'(x)dx=\\int (f(x)+g(x))dx"
            },
            {
                "type": "blank_line"
            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "יהי "
                    },
                    {
                        "type": "inline_math",
                        "raw": "\\alpha \\in \\mathbb{R}"
                    },
                    {
                        "type": "text",
                        "raw": ". נגדיר "
                    },
                    {
                        "type": "inline_math",
                        "raw": "K(x)=\\displaystyle \\alpha F(x)"
                    },
                    {
                        "type": "text",
                        "raw": ". אזי:"
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "K'(x)=(\\alpha F(x))' \\underset{\\begin{matrix}\n\\downarrow \\\\\n\\R{\\text{כללי גזירה}}\n\\end{matrix}}{=}\\alpha F'(x)=\\alpha f(x)"
            },
            {
                "type": "block_math",
                "raw": "\\alpha \\int f(x)dx \\underset{\\begin{matrix}\n\\downarrow \\\\\n\\R{\\text{הגדרת אינטגרל}}\n\\end{matrix}}{=}\\alpha F(x)=K(x) \\underset{\\begin{matrix}\n\\downarrow \\\\\n\\R{\\text{הגדרת אינטגרל}}\n\\end{matrix}}{=} \\int K'(x)dx=\\int\\alpha f(x)dx"
            }
        ]
    },
    {
        "type": "blank_line"
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "block_math",
                "raw": "\\int \\frac{x^4}{1+x^2}dx=\\int \\frac{x^4-1+1}{1+x^2}dx=\\int \\frac{(x^2-1)(x^2+1)}{x^2+1}+\\frac{1}{x^2+1}dx="
            },
            {
                "type": "block_math",
                "raw": "\\int\\frac{(x^2-1)\\cancel{ (x^2+1) }}{\\cancel{ x^2+1 }}dx+\\int \\frac{1}{x^2+1}dx=\\int x^2dx-\\int1dx+\\int \\frac{1}{1+x^2}dx=\\frac{x^3}{3}-x+\\arctan x {\\; \\color{red}+\\; c}"
            }
        ],
        "attrs": {
            "callout_type": "example",
            "numbered": false,
            "title": "אינטגרל כמעט מיידי"
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "תהי "
                    },
                    {
                        "type": "inline_math",
                        "raw": "f(x):\\mathbb{R}\\to \\mathbb{R}"
                    },
                    {
                        "type": "text",
                        "raw": " כך ש-"
                    },
                    {
                        "type": "inline_math",
                        "raw": "f(x)\\neq 0"
                    },
                    {
                        "type": "text",
                        "raw": ". אזי:"
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "\\int \\frac{f'(x)}{f(x)}dx=\\ln |f(x)|+c"
            }
        ],
        "attrs": {
            "callout_type": "theorem",
            "numbered": false,
            "title": ""
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "paragraph",
        "children": [
            {
                "type": "text",
                "raw": "נבדוק זאת ע\"י גזירה:"
            }
        ]
    },
    {
        "type": "block_math",
        "raw": "(\\ln|f(x)|+c)'=\\begin{cases}\n\\frac{f'(x)}{f(x)} & x>0 \\\\\n\\frac{-f'(x)}{-f(x)} & x<0\n\\end{cases}=\\frac{f'(x)}{f(x)}"
    },
    {
        "type": "blank_line"
    },
    {
        "type": "proof",
        "children": [
            {
                "type": "blank_line"
            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "גזירה לפי כלל השרשרת."
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "(\\ln |f(x)|+c)'=\\frac{|f'(x)|}{|f(x)|}=\\frac{f'(x)}{f(x)}"
            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "נסמן "
                    },
                    {
                        "type": "inline_math",
                        "raw": "\\displaystyle F^*(x)=\\int \\frac{f'(x)}{f(x)}dx"
                    },
                    {
                        "type": "text",
                        "raw": " ואז:"
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "(F^*(x))'=\\frac{f'(x)}{f(x)}=(\\ln |f(x)|+c)'"
            },
            {
                "type": "block_math",
                "raw": "\\int \\frac{f'(x)}{f(x)}dx=F^*(x)=\\int (F^*(x))'dx=\\int (\\ln |f(x)|+c)'dx=\\ln |f(x)|+c"
            }
        ]
    },
    {
        "type": "blank_line"
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "block_math",
                "raw": "\\int \\tan xdx=\\int \\frac{\\sin x}{\\cos x}dx \\underset{\\begin{matrix}\n\\downarrow \\\\\n\\R{\\text{המשפט הנ\"ל}}\n\\end{matrix}}{=}-\\ln |\\cos x|+c"
            }
        ],
        "attrs": {
            "callout_type": "example",
            "numbered": false,
            "title": "עוד דוגמה של אינטגרל כמעט מיידי"
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "לא לכל "
                    },
                    {
                        "type": "inline_math",
                        "raw": "f"
                    },
                    {
                        "type": "text",
                        "raw": " יש פונקציה קדומה. לדוגמה:"
                    }
                ]
            },
            {
                "type": "block_code",
                "raw": "width=200; height=200;\nbottom=-1; top=2\n---\nf(x)=0 |x<0\ng(x)=1 |x>1\n",
                "style": "fenced",
