            "level": 2
        },
        "style": "atx",
        "children": [
            {
                "type": "text",
                "raw": "אינטגרציה בחלקים"
            }
        ]
    },
    {
        "type": "paragraph",
        "children": [
            {
                "type": "text",
                "raw": "יהיו שתי פונקציות "
            },
            {
                "type": "inline_math",
                "raw": "u,v"
            },
            {
                "type": "text",
                "raw": ". אזי לפי נגזרת של מכפלה:"
            }
        ]
    },
    {
        "type": "block_math",
        "raw": "(uv)'=(u(x)\\cdot v(x))'=u'v+uv'"
    },
    {
        "type": "paragraph",
        "children": [
            {
                "type": "text",
                "raw": "נפעיל על שני האגפים אינטגרל(לפי ליניאריות נוכל להגיע לצורה הבאה):"
            }
        ]
    },
    {
        "type": "block_math",
        "raw": "uv+c=\\int u'v+\\int uv'"
    },
    {
        "type": "block_math",
        "raw": "\\qquad \\qquad \\qquad \\Downarrow - \\R{\\text{העברת אגפים}}"
    },
    {
        "type": "block_math",
        "raw": "\\int uv'=uv-\\int u'v"
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "יהיו "
                    },
                    {
                        "type": "inline_math",
                        "raw": "u,v:\\mathbb{R}\\to \\mathbb{R}"
                    },
                    {
                        "type": "text",
                        "raw": " בעלות פונקציה קדומה וגזירות. אזי:"
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "\\int uv'=uv-\\int u'v"
            }
        ],
        "attrs": {
            "callout_type": "theorem",
            "numbered": false,
            "title": "שהוכחנו הרגע"
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "block_math",
                "raw": "\\int xe^xdx \\implies \\begin{matrix}\nu=x & v'=e^x \\\\\nu'=1 & v=e^x\n\\end{matrix} \\implies \\int xe^xdx=xe^x-\\int e^xdx=xe^x-e^x+c"
            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "strong",
                        "children": [
                            {
                                "type": "text",
                                "raw": "מומלץ תמיד לרשום מי זה "
                            },
                            {
                                "type": "inline_math",
                                "raw": "u"
                            },
                            {
                                "type": "text",
                                "raw": " ומי זה "
                            },
                            {
                                "type": "inline_math",
                                "raw": "v"
                            },
                            {
                                "type": "text",
                                "raw": " גם כשכבר סופר מיומנים באינטגרציה בחלקים"
                            }
                        ]
                    },
                    {
                        "type": "text",
                        "raw": "."
                    },
                    {
                        "type": "linebreak"
                    },
                    {
                        "type": "text",
                        "raw": "נבדוק באמצעות נגזרת:"
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "(xe^x-e^x+c)'=e^x+xe^x-e^x=xe^x"
            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "כנדרש."
                    }
                ]
            }
        ],
        "attrs": {
            "callout_type": "example",
            "numbered": false,
            "title": ""
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "block_math",
                "raw": "\\int e^x\\cos xdx\\implies \\begin{matrix}\nv'=e^x & u=\\cos x \\\\\nv=e^x & u'=-\\sin x\n\\end{matrix}\\implies \\int e^x\\cos xdx=e^x\\cos x+\\int e^x\\sin xdx"
            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "עכשיו יש רגע של התלבטות - קיבלנו משהו שנראה באותה רמת קושי כמו שהתחלנו איתו. בואו ננסה עוד פעם(רק צריך להיזהר מהמלכודת של לעשות את אותו הדבר שוב ושוב כמו בלופיטל)"
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "\\begin{matrix}\nu=\\sin x & v'=e^x \\\\\nu'=\\cos x & v=e^x\n\\end{matrix}\\implies e^x\\cos x+\\int e^x\\sin xdx=e^x\\cos x+e^x\\sin x-\\int e^x\\cos xdx"
            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "נשים לב כי הגענו לאינטגרל שהתחלנו ממנו. נשים לב בנוסף כי אנחנו יכולים להעביר אגף ולכן:"
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "2\\int e^x\\cos xdx=e^x\\cos x+e^x\\sin x+c \\implies \\int e^x\\cos xdx=\\frac{e^x\\cos x+e^x\\sin x}{2}+c"
            }
        ],
        "attrs": {
            "callout_type": "example",
            "numbered": false,
            "title": ""
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "block_math",
                "raw": "\\int \\arctan xdx=\\int 1\\cdot \\arctan xdx\\implies \\begin{matrix}\nv'=1 & u=\\arctan x \\\\\nv=x & u'=\\frac{1}{1+x^2}\n\\end{matrix}"
            },
            {
                "type": "block_math",
                "raw": "\\int 1\\cdot \\arctan xdx=x \\arctan x-\\int \\frac{x}{1+x^2}dx=x\\arctan x-\\frac{1}{2}\\ln |1+x^2|+c"
            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "נבדוק באמצעות גזירה:"
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "\\left( x \\arctan x-\\frac{1}{2}\\ln |1+x^2|+c \\right)'= HW"
            }
        ],
        "attrs": {
            "callout_type": "example",
            "numbered": false,
            "title": ""
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "heading",
        "attrs": {
            "level": 2
        },
        "style": "atx",
        "children": [
            {
                "type": "text",
                "raw": "אינטגרל של פונקציה רציונלית"
            }
        ]
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "בתרגול: אינטגרל של פונקציה רציונלית."
                    },
                    {
                        "type": "linebreak"
                    },
                    {
                        "type": "text",
                        "raw": "אני אוסיף את המשפטים מהתרגול פה למטה:"
                    }
                ]
            }
        ],
        "attrs": {
            "callout_type": "remark",
            "numbered": false,
            "title": ""
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "heading",
        "attrs": {
            "level": 2
        },
        "style": "atx",
        "children": [
            {
                "type": "text",
                "raw": "שיטת ההצבה"
            }
        ]
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "block_math",
                "raw": "\\int \\sin^2x\\cos xdx \\underset{\\begin{pmatrix}\nt=\\sin x \\\\\n\\frac{dt}{dx}=\\cos x \\\\\n\\Downarrow - \\R{\\text{ההצדקה במשפט שיבוא}} \\\\\ndt=\\cos xdx\n\\end{pmatrix}}{=} \\int t^2dt=\\frac{t^3}{3}+c=\\frac{\\sin^3x}{3}+c"
            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "בואו נשתכנע שזה נכון באמצעות גזירה:"
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "\\left( \\frac{\\sin^3x}{3}+c \\right)'=\\frac{3\\sin^2x\\cos x}{3}=\\sin^2x\\cos x"
            }
        ],
        "attrs": {
            "callout_type": "example",
            "numbered": false,
            "title": ""
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "block_math",
                "raw": "\\int 2xe^{x^2}dx \\underset{\\begin{pmatrix}\nt=x^2 \\\\\ndt=2xdx\n\\end{pmatrix}}{=}\\int e^tdt=e^t+c=e^{x^2}+c"
            }
        ],
        "attrs": {
            "callout_type": "example",
            "numbered": false,
            "title": ""
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "paragraph",
        "children": [
            {
                "type": "text",
                "raw": "המשפט שנראה, שנקרא שיטת ההצבה, הוא הדואלי של כלל השרשרת(כמו שאינטגרציה בחלקים זה הדואלי של נגזרת של מכפלה)"
            }
        ]
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "תהי "
                    },
                    {
                        "type": "inline_math",
                        "raw": "f:I\\to \\mathbb{R}"
                    },
                    {
                        "type": "text",
                        "raw": " בעלת פונקציה קדומה ב-"
                    },
                    {
                        "type": "inline_math",
                        "raw": "I"
                    },
                    {
                        "type": "text",
                        "raw": " ותהי "
                    },
                    {
                        "type": "inline_math",
                        "raw": "x=\\varphi(t),\\;\\varphi:J\\to I"
                    },
                    {
                        "type": "text",
                        "raw": " גזירה והפיכה. אזי:"
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "\\int f(x)dx=\\int f(\\varphi(t))\\varphi'(t)dt"
            }
        ],
        "attrs": {
            "callout_type": "theorem",
            "numbered": false,
            "title": "שיטת ההצבה"
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "proof",
        "children": [
            {
                "type": "blank_line"
            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "נסמן ב-"
                    },
                    {
                        "type": "inline_math",
                        "raw": "F"
                    },
                    {
                        "type": "text",
                        "raw": " פונקציה קדומה של "
                    },
                    {
                        "type": "inline_math",
                        "raw": "f"
                    },
                    {
                        "type": "text",
                        "raw": "."
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "{\\Large(}F(\\varphi(t)){\\Large)}'=F'(\\varphi(t))\\cdot \\varphi'(t)=f(\\varphi(t))\\varphi'(t)"
            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "נפעיל אינטגרל על שני האגפים:"
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "\\int f(\\varphi(t))\\varphi'(t)dt=F(\\varphi(t))+c=F(x)+c=\\int f(x)dx"
            }
        ]
    },
    {
        "type": "blank_line"
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "אנו דורשים ש-"
                    },
                    {
                        "type": "inline_math",
                        "raw": "\\varphi"
                    },
                    {
                        "type": "text",
                        "raw": " תהיה הפיכה על מנת שנוכל להשתמש גם בכיוון של "
                    },
                    {
                        "type": "inline_math",
                        "raw": "t=\\varphi^{-1}(x)"
                    },
                    {
                        "type": "text",
                        "raw": " כפי שעשינו בדוגמות ממקודם."
                    }
                ]
            }
        ],
        "attrs": {
            "callout_type": "remark",
            "numbered": false,
            "title": ""
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "block_math",
                "raw": "x>0, \\int \\frac{\\sqrt{ x }}{x+1}dx \\underset{\\begin{matrix}\n\\downarrow \\\\\n\\R{\\text{שיטת ההצבה}} \\\\\n\\begin{pmatrix}\nt=\\sqrt{ x } \\\\\nx=t^2\\; \\leftarrow\\; \\varphi(t) \\\\\ndx=2tdt\n\\end{pmatrix}\n\\end{matrix}}{=}\\int \\frac{t}{t^2+1}2tdt=2\\int \\frac{t^2}{t^2+1}dt=2\\int \\frac{t^2-1+1}{t^2+1}dt="
            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "זה אותו פעלול שראינו קודם."
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "\\int \\frac{t^2+1}{t^2+1}dt-\\int \\frac{1}{t^2+1}dt=t-\\arctan t+c\n=2t-2\\arctan t+c=2\\sqrt{ x }-2\\arctan \\sqrt{ x }+c"
            }
        ],
        "attrs": {
            "callout_type": "example",
            "numbered": false,
            "title": ""
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "תעשו את "
                    },
                    {
                        "type": "inline_math",
                        "raw": "\\int e^{-|x|}dx"
                    },
                    {
                        "type": "text",
                        "raw": ". יהיה משהו מאוד דומה בגליון בית."
                    }
                ]
            }
        ],
        "attrs": {
            "callout_type": "exercise",
            "numbered": false,
            "title": ""
        }
    },
    {
        "type": "blank_line"
    },
    {
        "type": "callout",
        "children": [
            {
                "type": "block_math",
                "raw": "\\int \\tan xdx=\\int \\frac{\\sin x}{\\cos x}dx \\underset{\\begin{matrix}\n\\downarrow \\\\\n\\R{\\text{אינטגרציה בחלקים}} \\\\\n\\begin{pmatrix}\nv'=\\sin x & u=\\frac{1}{\\cos x} \\\\\nv=-\\cos x & u'=-\\frac{1}{\\cos^2x}(-\\sin x)\n\\end{pmatrix}\n\\end{matrix}}{=}-1+\\int \\frac{\\sin x}{\\cos x}dx=-1+\\int \\tan xdx"
            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "אם ננסה לצמצם כמו ממקודם נקבל ש-"
                    },
                    {
                        "type": "inline_math",
                        "raw": "0=-1"
                    },
                    {
                        "type": "text",
                        "raw": " והכל נשבר. רק שבעצם זה בכלל "
                    },
                    {
                        "type": "inline_math",
                        "raw": "0+c=-1+c"
                    },
                    {
                        "type": "text",
                        "raw": " שזה נכון כי זו אותה משפחה של פונקציות."
                    }
                ]
            }
        ],
        "attrs": {
            "callout_type": "example",
            "numbered": false,
            "title": ""
        }
    },
    {
        "type": "blank_line"
    }
]