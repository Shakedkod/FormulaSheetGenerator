            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "לכל "
                    },
                    {
                        "type": "inline_math",
                        "raw": "c \\in \\mathbb{R}"
                    },
                    {
                        "type": "text",
                        "raw": " מתקיים "
                    },
                    {
                        "type": "inline_math",
                        "raw": "(F(x)+c)'=f(x)"
                    },
                    {
                        "type": "text",
                        "raw": ". (לפי כללי גזירה)"
                    },
                    {
                        "type": "linebreak"
                    },
                    {
                        "type": "text",
                        "raw": "בנוסף, תהי "
                    },
                    {
                        "type": "inline_math",
                        "raw": "G(x)"
                    },
                    {
                        "type": "text",
                        "raw": " פונקציה קדומה אחרת של "
                    },
                    {
                        "type": "inline_math",
                        "raw": "f"
                    },
                    {
                        "type": "text",
                        "raw": "."
                    },
                    {
                        "type": "linebreak"
                    },
                    {
                        "type": "text",
                        "raw": "נסמן: "
                    },
                    {
                        "type": "inline_math",
                        "raw": "H=G-F"
                    },
                    {
                        "type": "text",
                        "raw": ". אזי,"
                    }
                ]
            },
            {
                "type": "block_math",
                "raw": "H'=G'-F'=f-f=0"
            },
            {
                "type": "paragraph",
                "children": [
                    {
                        "type": "text",
                        "raw": "לכן, לפי מסקנה מלגרנז', "
                    },
                    {
                        "type": "inline_math",
                        "raw": "H=c"
                    },
                    {
                        "type": "text",
                        "raw": " עבור איזשהו "
                    },
                    {
                        "type": "inline_math",
                        "raw": "c \\in \\mathbb{R}"
                    },
                    {
                        "type": "text",
                        "raw": ". לכן, "
                    },
                    {
                        "type": "inline_math",
                        "raw": "G-F=c"
                    },
                    {
                        "type": "text",
                        "raw": ". כלומר, "
                    },
                    {
                        "type": "inline_math",
                        "raw": "G=F+c"
                    }
                ]
            }
        ]
    },
    {
        "type": "blank_line"
    },
    {
        "type": "paragraph",
        "children": [
            {
                "type": "text",
                "raw": "כלומר, אם לפונקציה יש פונקציה קדומה(ולא לכל הפונקציות יש) אז יש לה "
            },
            {
                "type": "inline_math",
                "raw": "\\infty"
